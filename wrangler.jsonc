// Configurazione per Cloudflare Workers con risorse statiche (worker.js).
// I segreti (ANTHROPIC_API_KEY, ADMIN_TOKEN, RESEND_API_KEY) si mettono nel
// cruscotto o con `npx wrangler secret put NOME`, mai qui.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ricettario",
  "main": "worker.js",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api", "/api/*"]
  },
  // Il database D1 si aggiunge qui appena creato (binding "DB"): senza, l'app funziona ma senza accessi, budget e sincronizzazione.
  "vars": {
    "MONTHLY_BUDGET_USD": "3",
    "DAILY_BUDGET_USD": "5"
  },
  "observability": { "enabled": true }
}

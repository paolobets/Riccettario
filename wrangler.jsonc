// Configurazione per Cloudflare Workers con risorse statiche (worker.js).
// I segreti (ANTHROPIC_API_KEY, ADMIN_TOKEN, RESEND_API_KEY) si mettono nel
// cruscotto o con `npx wrangler secret put NOME`, mai qui.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ricettario",
  "main": "worker.js",
  "compatibility_date": "2025-09-01",
  "workers_dev": true,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api", "/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "ricettario",
      "database_id": "6feda3f8-086a-4dc3-8db2-6a114d36d320"
    }
  ],
  "vars": {
    "MONTHLY_BUDGET_USD": "3",
    "DAILY_BUDGET_USD": "5"
  },
  "observability": { "enabled": true }
}
